{
  "schemaVersion": 1,
  "id": "spv_addon",
  "version": "${version}",
  "name": "The Volatile Addon",
  "description": "Adds a bunch of stuff to space potatoes found footage mod",
  "icon": "Volatileicon.png",
  "authors": [
    "DarkFox Studios"
  ],
  "accessWidener": "spv_addon.accesswidener",
  "entrypoints": {
    "main": [
      "net.dark.spv_addon.Spv_addon"
    ],
    "client": [
      "net.dark.spv_addon.Spv_addonClient"
    ],
    "cardinal-components": [
      "net.dark.spv_addon.cca.InitializeComponents"
    ],
    "voicechat": [
      "net.dark.spv_addon.init.voicechat.SpvAddonVoicechatPlugin"
    ],
    "modmenu": [
      "net.dark.spv_addon.init.config.ModMenuIntegration"
    ]
  },
  "custom": {
    "cardinal-components": [
      "spv_addon:bell_walker",
      "spv_addon:thirst",
      "spv_addon:flashlight_battery",
      "spv_addon:sanity",
      "spv_addon:run_timer",
      "spv_addon:death_teleport",
      "spv_addon:level_run"
    ]
  },
  "mixins": [
    "spv_addon.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "cardinal-components-base": "*",
    "spb-revamped": ">=1.2.0",
    "midnightlib": ">=1.4.1"
  },
  "suggests": {
    "modmenu": "*"
  }
}
