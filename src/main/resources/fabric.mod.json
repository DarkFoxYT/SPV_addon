{
  "schemaVersion": 1,
  "id": "spv_addon",
  "version": "1.0",
  "name": "The Volatile Addon",
  "description": "Adds stuff to space potatoes found footage mod",
  "authors": [
    "DarkFox"
  ],
  "accessWidener": "spv_addon.accesswidener",

  "entrypoints": {
    "main": [
      "net.dark.spv_addon.Spv_addon"
    ],
    "client": [
      "net.dark.spv_addon.Spv_addonClient"
    ],
    "cardinal-components": [
      "net.dark.spv_addon.cca.InitializeComponents"
    ],
    "voicechat": [
      "net.dark.spv_addon.voicechat.SpvAddonVoicechatPlugin"
    ]
  },
  "custom": {
    "cardinal-components": [
      "spv_addon:bell_walker",
      "spv_addon:kitty",
      "spv_addon:thirst",
      "spv_addon:flashlight_battery",
      "spv_addon:sanity",
      "spv_addon:run_timer",
      "spv_addon:death_teleport"

    ]
  },


  "mixins": [
    "spv_addon.mixins.json"
  ],

  "depends": {
    "fabricloader": "*",
    "fabric-api": "*",
    "cardinal-components-base": "*",
    "spb-revamped": "*"
  }
}
